---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { waMessages } from '../../lib/whatsapp';
---

<BaseLayout
  title="Hizmetlerimiz | Zirve Halı & Koltuk Yıkama Tire"
  description="Tire'de halı yıkama, koltuk yıkama, stor perde, yorgan ve battaniye yıkama, yerinde temizlik, sandalye ve araç koltuğu temizliği. Fiyat için hemen yazın."
>
  <SiteHeader
    slot="header"
    current="/hizmetler/"
    crumbs={[{ label: 'Ana sayfa', href: '/' }, { label: 'Hizmetler' }]}
    title="Hizmetlerimiz"
    description="Halıdan araç koltuğuna kadar evinizdeki tüm tekstil ürünlerini, kumaşına uygun yöntemle yıkıyoruz."
  />

  <section class="wrap pt-8 pb-20">
    {
      services.map((service, i) => (
        <article
          id={service.id}
          class:list={[
            'flex flex-wrap items-center gap-x-14 gap-y-8 py-12',
            i < services.length - 1 && 'border-b border-line',
            i % 2 === 1 && 'flex-row-reverse',
          ]}
        >
          {service.image ? (
            <Picture
              src={service.image}
              alt={service.imageAlt ?? ''}
              widths={[340, 560, 720, 1080]}
              sizes="(min-width: 1024px) 560px, 100vw"
              formats={['avif', 'webp']}
              class="aspect-[4/3] w-full rounded-2xl object-cover"
              pictureAttributes={{ class: 'block min-w-0 flex-[1_1_340px]' }}
            />
          ) : (
            <div class="flex aspect-[4/3] min-w-0 flex-[1_1_340px] flex-col items-center justify-center gap-3 rounded-2xl bg-sand text-teal">
              <Icon name={service.icon} size={56} strokeWidth={1.3} />
              <span class="text-[13px] font-semibold text-muted">{service.placeholder}</span>
            </div>
          )}
          <div class="flex min-w-0 flex-[1_1_380px] flex-col gap-3.5">
            <span class="text-sm font-extrabold text-teal">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="m-0 text-[clamp(28px,3vw,38px)] leading-[1.1] font-extrabold tracking-[-0.03em]">
              {service.pageTitle}
            </h2>
            <p class="m-0 text-base leading-[1.65] text-muted">{service.description}</p>
            {service.features.length > 0 && (
              <ul class="m-0 mt-1 flex list-none flex-col gap-2.5 p-0 text-[15px] font-semibold">
                {service.features.map((feature) => (
                  <li class="flex items-center gap-2.5">
                    <Icon name="check" size={18} strokeWidth={2.4} class="text-teal" />
                    {feature}
                  </li>
                ))}
              </ul>
            )}
            <div class="mt-2 flex flex-wrap gap-x-7 gap-y-2 text-[15px] font-bold">
              {service.links.map((link) => (
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noopener' : undefined}
                  class:list={['inline-flex min-h-11 items-center no-underline', 'transition-colors duration-150', link.primary ? 'text-teal hover:text-teal-dark' : 'text-ink hover:text-teal']}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <CtaBand title="Hangi hizmete ihtiyacınız var? Bir mesajla net fiyat alın." waText={waMessages.anyPrice} />
</BaseLayout>
