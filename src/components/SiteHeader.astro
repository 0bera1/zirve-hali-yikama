---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { navLinks, phoneHref, site } from '../data/site';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  /** Aktif menü bağlantısının yolu (örn. /hizmetler/) */
  current?: string;
  crumbs?: Crumb[];
  title?: string;
  description?: string;
}

const { current, crumbs = [], title, description } = Astro.props;
const hasCustomHero = Astro.slots.has('default');
---

<section class="bg-ink text-white">
  <header class="wrap">
    <div class="flex h-[76px] items-center justify-between gap-4">
      <Logo href="/" size="sm" />
      <div class="flex items-center gap-2">
        <a
          href={phoneHref}
          class="flex h-11 items-center gap-2 rounded-full border border-white/50 px-4 text-sm font-bold whitespace-nowrap text-white no-underline transition-colors duration-150 hover:border-white hover:bg-white/10"
        >
          <Icon name="phone" size={18} />
          <span class="sm:hidden">Ara</span>
          <span class="hidden sm:inline">{site.phoneDisplay}</span>
        </a>
        <MobileMenu current={current} />
      </div>
    </div>
    <nav
      aria-label="Ana menü"
      class="no-scrollbar hidden gap-7 overflow-x-auto border-t border-white/12 text-sm font-semibold whitespace-nowrap md:flex"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={link.href === current ? 'page' : undefined}
            class="border-b-2 border-transparent pt-3.5 pb-3 text-on-dark no-underline transition-colors duration-150 hover:text-white aria-[current=page]:border-sun aria-[current=page]:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </header>

  {
    hasCustomHero ? (
      <slot />
    ) : (
      <div class="wrap flex flex-col gap-5 pt-14 pb-[72px]">
        {crumbs.length > 0 && (
          <nav aria-label="Konum" class="text-sm text-on-dark-muted">
            <ol class="m-0 flex list-none flex-wrap gap-x-2 p-0">
              {crumbs.map((crumb, i) => (
                <li>
                  {crumb.href ? <a href={crumb.href} class="text-on-dark underline transition-colors hover:text-white">{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
                  {i < crumbs.length - 1 && <span aria-hidden="true" class="ml-2">/</span>}
                </li>
              ))}
            </ol>
          </nav>
        )}
        <h1 class="h-page m-0">{title}</h1>
        {description && <p class="m-0 max-w-[600px] text-lg leading-[1.6] text-on-dark">{description}</p>}
      </div>
    )
  }
</section>
