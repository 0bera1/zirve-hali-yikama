---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 20, strokeWidth = 2, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', className]}
  aria-hidden="true"
  set:html={icons[name]}
/>
