---
import type { Faq } from '../data/faqs';

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<div class="border-t border-line">
  {
    items.map((item, i) => (
      <details open={i === 0} class="group border-b border-line">
        <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-[18px] text-left text-[17px] font-bold transition-colors duration-150 hover:text-teal [&::-webkit-details-marker]:hidden">
          <span>{item.question}</span>
          <span aria-hidden="true" class="shrink-0 text-2xl font-medium text-teal">
            <span class="group-open:hidden">+</span>
            <span class="hidden group-open:inline">−</span>
          </span>
        </summary>
        <p class="m-0 pb-[22px] text-base leading-[1.65] text-muted">{item.answer}</p>
      </details>
    ))
  }
</div>
